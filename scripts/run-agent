#!/usr/bin/env bash
# Unified agent launcher.
#
# Reads `agent:` from the --config YAML (following `extends:` chains) and
# dispatches to the right agent module via run_with_compute. --agent NAME
# on the CLI overrides the config value.
#
# Usage:
#   run-agent --config configs/anthropics/claude_opus.yaml
#   run-agent --config configs/anthropics/claude_opus.yaml --compute slurm
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "${REPO_ROOT}/agent_runtime/shell/agent_env.sh"

# Conda activation is needed before we can call `python` to parse the config.
if ! activate_lhc_analysis; then
  bootstrap_lhc_analysis
fi
ensure_python_modules

# ── Parse --agent (consumed) and --config (forwarded) ──────────────────────
AGENT=""
CONFIG=""
FORWARDED=()
CONFIG_ARG_INDEX=-1
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent)      AGENT="$2"; shift 2 ;;
    --agent=*)    AGENT="${1#--agent=}"; shift ;;
    --config)     CONFIG="$2"; CONFIG_ARG_INDEX=${#FORWARDED[@]}; FORWARDED+=("$1" "$2"); shift 2 ;;
    --config=*)   CONFIG="${1#--config=}"; CONFIG_ARG_INDEX=${#FORWARDED[@]}; FORWARDED+=("$1"); shift ;;
    *)            FORWARDED+=("$1"); shift ;;
  esac
done

resolve_config_path() {
  local path="$1"
  if [[ -f "${path}" ]]; then
    printf '%s\n' "${path}"
    return 0
  fi

  # Compatibility for parent scripts launched before configs moved into
  # harness-specific subdirectories. Example:
  # configs/codex_gpt55.yaml -> configs/openai/codex_gpt55.yaml.
  local base
  base="$(basename "${path}")"
  mapfile -t matches < <(find "${REPO_ROOT}/configs" -mindepth 2 -maxdepth 2 -type f -name "${base}" | sort)
  if [[ ${#matches[@]} -eq 1 ]]; then
    printf '%s\n' "${matches[0]}"
    return 0
  fi
  return 1
}

if [[ -n "${CONFIG}" ]]; then
  if RESOLVED_CONFIG="$(resolve_config_path "${CONFIG}")"; then
    if [[ "${RESOLVED_CONFIG}" != "${CONFIG}" ]]; then
      echo "run-agent: resolved moved config ${CONFIG} -> ${RESOLVED_CONFIG}" >&2
      CONFIG="${RESOLVED_CONFIG}"
      if [[ ${CONFIG_ARG_INDEX} -ge 0 ]]; then
        if [[ "${FORWARDED[$CONFIG_ARG_INDEX]}" == "--config" ]]; then
          FORWARDED[$((CONFIG_ARG_INDEX + 1))]="${CONFIG}"
        else
          FORWARDED[$CONFIG_ARG_INDEX]="--config=${CONFIG}"
        fi
      fi
    fi
  fi
fi

# ── Resolve agent from config (follow extends: chain) ──────────────────────
if [[ -z "${AGENT}" && -n "${CONFIG}" ]]; then
  if [[ ! -f "${CONFIG}" ]]; then
    echo "run-agent: config not found: ${CONFIG}" >&2
    exit 2
  fi
  AGENT="$(python - "${CONFIG}" <<'PY'
import sys
from agent_runtime.config import read_agent_from_config

agent = read_agent_from_config(sys.argv[1])
if agent:
    print(agent)
PY
)"
fi

if [[ -z "${AGENT}" ]]; then
  echo "run-agent: --agent NAME required, or set \`agent:\` in --config." >&2
  echo "  Known agents: simple, baseline, iterative, anneal" >&2
  echo "  Example: bin/run-agent --config configs/anthropics/claude_opus.yaml" >&2
  exit 2
fi

# Resolve `auth` from the config (default: "oauth" when unset). The claude
# CLI silently prefers ANTHROPIC_API_KEY over the user's OAuth login when
# both are present, so we must not export the API key on OAuth-intended
# runs — and must actively strip any inherited API-auth env on that path.
AUTH="oauth"
if [[ -n "${CONFIG}" ]]; then
  AUTH="$(python - "${CONFIG}" <<'PY'
import sys
from agent_runtime.config import load_config

cfg = load_config(sys.argv[1])
print(cfg.get("auth") or "oauth")
PY
)"
fi

API_KEYS_FILE="${LHC_RECAST_API_KEYS_FILE:-${REPO_ROOT}/.api_keys.env}"
if [[ "${AUTH}" == "api" ]]; then
  if [[ -f "${API_KEYS_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${API_KEYS_FILE}"
  fi
  echo "run-agent: auth=api" >&2
else
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL
  echo "run-agent: auth=oauth" >&2
fi

# Catch missing API-key auth before requesting an interactive allocation.
if [[ -n "${CONFIG}" ]]; then
  python - "${CONFIG}" <<'PY'
import sys

from agent_runtime.config import load_config, validate_api_auth_env

try:
    validate_api_auth_env(load_config(sys.argv[1]))
except ValueError as exc:
    print(f"run-agent: {exc}", file=sys.stderr)
    raise SystemExit(2)
PY
fi

case "${AGENT}" in
  simple)    PY_MODULE="agents.simple.run" ;;
  baseline)  PY_MODULE="agents.baseline.run" ;;
  iterative) PY_MODULE="agents.iterative.runtime.controller.recast_loop" ;;
  anneal)    PY_MODULE="agents.anneal.runtime.controller.anneal_loop" ;;
  *)
    echo "run-agent: unknown agent '${AGENT}'. Must be simple|baseline|iterative|anneal." >&2
    exit 2 ;;
esac

export PY_MODULE
run_with_compute "${FORWARDED[@]+"${FORWARDED[@]}"}"
