#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}"
DOC="${REPO_ROOT}/ColliderBench/tools/CLI/READ-PAPER.md"

case "${1:-}" in
  --doc) exec cat "${DOC}" ;;
esac

source "${REPO_ROOT}/agent_runtime/shell/agent_env.sh"

if ! activate_lhc_analysis; then
  bootstrap_lhc_analysis
fi

# Make the shim self-sufficient: set PYTHONPATH so `python -m` finds
# the ColliderBench package regardless of cwd or how the agent harness
# invokes us. Do NOT cd to REPO_ROOT — that would silently rewrite
# relative-path arguments (the agent passes `papers/foo.pdf` relative
# to its workspace, and a sneaky cd would break that).
export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:$PYTHONPATH}"
exec python -m ColliderBench.tools.CLI.read_paper "$@"
