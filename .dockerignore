# Stripped from the build context in docker/Dockerfile so the resulting
# image doesn't bake in developer-local cache / state. Mirrors the
# generic patterns from .gitignore.

# Editor / OS noise
.vscode/
.idea/
.DS_Store
._*

# Python cache
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run outputs and ephemeral state
runs/
recast_*/
simulate_*/
validate_*/

# Build artifacts
build/
dist/
*.egg-info/
