#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)}"
DOC="${REPO_ROOT}/ColliderBench/tools/CLI/CMS-OPENDATA.md"

case "${1:-}" in
  --doc) exec cat "${DOC}" ;;
esac

source "${REPO_ROOT}/agent_runtime/shell/agent_env.sh"

if ! activate_lhc_analysis; then
  bootstrap_lhc_analysis
fi

# Self-sufficient: set PYTHONPATH so `python -m` finds the package
# regardless of cwd. Don't cd — relative-path arguments must stay
# relative to the caller's workspace.
export PYTHONPATH="${REPO_ROOT}${PYTHONPATH:+:$PYTHONPATH}"
exec python -m ColliderBench.tools.CLI.cms_opendata "$@"
