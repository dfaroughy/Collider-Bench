agents/anneal/
agents/baseline/
configs/claude_anneal.yaml
configs/codex_anneal.yaml
configs/gemini_anneal.yaml
configs/claude_baseline.yaml
configs/codex_baseline.yaml
configs/gemini_baseline.yaml

# Run outputs and ephemeral state
runs/
recast_*/
simulate_*/
validate_*/
__pycache__/
.pytest_cache/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
._*
