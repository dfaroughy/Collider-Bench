._*
.DS_Store
__MACOSX/

# Agent run outputs — frozen artifacts, not source of truth.
runs/
# Stray top-level run dirs (old layout, or tests that skip runs/).
recast_*/
simulate_*/
validate_*/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Codex session state (auto-seeded by CodexRunner into workspace/.codex_home/)
.codex_home/

# Build / packaging
build/
dist/
*.egg-info/
*.egg

# Packed conda env (multi-GB binary blob — re-create with
# `conda pack -n lhc_analysis -o docker/lhc_analysis_env.tar.gz`).
docker/lhc_analysis_env.tar.gz

# ── Internal SLURM submitters (NERSC-specific, not part of public release) ────
scripts/multi-run-interactive.sh
scripts/submit_production_simple.sh
scripts/submit_simple_benchmark.sh
scripts/sbatch_simple_array.sh

# ── Private agents (kept locally, not part of the public benchmark) ────────
agents/anneal/
agents/baseline/
configs/claude_anneal.yaml
configs/codex_anneal.yaml
configs/gemini_anneal.yaml
configs/claude_baseline.yaml
configs/codex_baseline.yaml
configs/gemini_baseline.yaml
tests/test_anneal_schedule.py
tests/test_prompts_private.py

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code per-project settings (permissions allowlists, hooks — user-specific)
.claude/

# Large archival directory — not part of the active tree.
old/

# LaTeX draft scratch
draft/*.aux
draft/*.log
draft/*.out
draft/*.synctex.gz

# Prospino build products (reproducible from the vendored source via `make`)
LHCRecastBench/tools/sim/prospino/**/*.o
LHCRecastBench/tools/sim/prospino/**/*.mod
LHCRecastBench/tools/sim/prospino/prospino_2.run
LHCRecastBench/tools/sim/prospino/prospino.dat*
LHCRecastBench/tools/sim/prospino/screen.out
# Per-invocation scratch dirs created by bin/prospino
prospino_scratch/
.ghcr_token
.api_keys.env
.api_keys.*
.codex
*.sif
