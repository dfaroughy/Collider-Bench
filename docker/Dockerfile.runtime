# Our public runtime layer: adds Node and our vendor-neutral harness Python
# (`agent_runtime/`, the agent patterns under `agents/`, base config) on top
# of the benchmark image.
#
# This image is intentionally **vendor-neutral**: NO claude-code, codex,
# gemini-cli, or any other agent-specific CLI is installed here. Anyone
# who wants to run a specific agent against the benchmark either (a)
# extends this image with their own CLI install, or (b) runs from outside
# the container and uses this image only for the sim/scoring stack.
#
# A private overlay (`docker/Dockerfile.dev`, gitignored) extends this
# image with the closed-source vendor CLIs we use for our internal
# benchmark runs.

ARG BENCH_IMAGE=lhc-recast-bench:latest
FROM ${BENCH_IMAGE}

# Node 20 in the conda env — needed by any JS-based agent CLI an
# overlay image (or a host bind-mount) might bring in.
RUN mamba install -n cms_analysis -y -c conda-forge 'nodejs>=20' \
      && mamba clean -afy

ENV NPM_CONFIG_PREFIX=/opt/node-global
ENV PATH=/opt/node-global/bin:${PATH}

# Vendor-neutral harness Python: workspace builder, sandbox abstraction,
# Runner ABC + registry, agent patterns (simple/baseline/iterative/anneal).
# Concrete vendor `Runner` subclasses live in the gitignored
# `agent_runtime/_runners_vendor.py` and are NOT shipped here.
COPY agent_runtime /app/agent_runtime
COPY agents        /app/agents
COPY configs       /app/configs

ENV PYTHONPATH=/app:${PYTHONPATH}

WORKDIR /workspace
CMD ["/bin/bash"]
