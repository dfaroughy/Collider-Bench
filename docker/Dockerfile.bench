# Vendor-neutral benchmark image: execution environment + sim stack only.
#
# Anyone can use this to evaluate their own agent against the benchmark:
#   apptainer exec --bind <path>/LHCRecastBench:<path>/LHCRecastBench \
#                  lhc-recast-bench_latest.sif <their-agent-cmd>
#
# Does NOT contain: any agent CLI, any runner scaffold, our agent_runtime,
# our agents/, our configs/. Those live in the derived `runtime` image.

FROM condaforge/mambaforge:latest

ARG DEBIAN_FRONTEND=noninteractive

# System deps for building + running the vendored sim stack.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gfortran g++ make cmake git wget curl ca-certificates \
      libx11-dev libxpm-dev libxft-dev libxext-dev \
      zlib1g-dev libssl-dev \
      && rm -rf /var/lib/apt/lists/*

# Conda env (mirrors agent_runtime/shell/agent_env.sh's CMS_RECAST_PACKAGES).
RUN mamba create -n cms_analysis -y -c conda-forge \
      python=3.11 \
      pyyaml requests aiohttp \
      uproot awkward vector \
      numpy scipy matplotlib hist mplhep \
      xrootd fsspec-xrootd \
      && mamba clean -afy

# Default activation for every RUN/CMD in the image.
ENV PATH=/opt/conda/envs/cms_analysis/bin:${PATH}
ENV CONDA_DEFAULT_ENV=cms_analysis

# Vendored sim stack, baked at /opt/sim so the host's LHCRecastBench/tools/sim
# can be shadowed by this immutable copy when the host dir doesn't ship
# pre-built binaries. Sizes (approx): mg5 200 MB, pythia 290 MB, delphes 110 MB,
# prospino 60 MB. Total image ~3.5 GB before conda; ~4.5 GB after.
COPY LHCRecastBench/tools/sim/MG5_aMC_v3_7_0 /opt/sim/MG5_aMC_v3_7_0
COPY LHCRecastBench/tools/sim/pythia8313     /opt/sim/pythia8313
COPY LHCRecastBench/tools/sim/delphes        /opt/sim/delphes
COPY LHCRecastBench/tools/sim/prospino       /opt/sim/prospino

# Canonical env vars for sim tool lookup. bin/simulate honours these when set,
# falling back to ${REPO_ROOT}/LHCRecastBench/tools/sim/* otherwise.
ENV MG5_DIR=/opt/sim/MG5_aMC_v3_7_0
ENV PYTHIA8_DIR=/opt/sim/pythia8313
ENV DELPHES_DIR=/opt/sim/delphes
ENV PROSPINO_DIR=/opt/sim/prospino

WORKDIR /workspace
CMD ["/bin/bash"]
