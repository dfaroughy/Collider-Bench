._*
.DS_Store
__MACOSX/

# Agent run outputs — frozen artifacts, not source of truth.
runs/
# Stray top-level run dirs (old layout, or tests that skip runs/).
recast_*/
simulate_*/
validate_*/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Codex session state (auto-seeded by CodexRunner into workspace/.codex_home/)
.codex_home/

# Build / packaging
build/
dist/
*.egg-info/
*.egg

# Packed conda env (multi-GB binary blob — re-create with
# `conda pack -n lhc_analysis -o docker/lhc_analysis_env.tar.gz`).
docker/lhc_analysis_env.tar.gz

# ── Internal SLURM submitters (NERSC-specific, not part of public release) ────
# Public users get scripts/run-agent (works with --compute local) and
# scripts/launch_eval.sh; everything below assumes Perlmutter's SLURM,
# m4539 account, and NERSC interactive/regular qos.
scripts/sbatch_simple_array.sh
scripts/sbatch_api_array.sh
scripts/submit_api_parallel.sh
scripts/multi-run-interactive-*.sh
scripts/neurips_tasks.txt

# ── Private configs — public release ships only configs/claude{,_slurm}.yaml +
# configs/CONFIG.md. Everything else under configs/ is dfarough's working set
# (vendor-specific models, NERSC-shaped profiles, anneal variants) and stays
# local. New private configs can land under any of these paths without
# updating this file.
configs/anthropics/
configs/openai/
configs/google/
configs/forgecode/
configs/utils/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code per-project settings (permissions allowlists, hooks — user-specific)
.claude/

# Large archival directory — not part of the active tree.
old/

# LaTeX draft scratch
draft/*.aux
draft/*.log
draft/*.out
draft/*.synctex.gz

# Prospino build products (reproducible from the vendored source via `make`)
ColliderBench/tools/sim/prospino/**/*.o
ColliderBench/tools/sim/prospino/**/*.mod
ColliderBench/tools/sim/prospino/prospino_2.run
ColliderBench/tools/sim/prospino/prospino.dat*
ColliderBench/tools/sim/prospino/screen.out
# Per-invocation scratch dirs created by bin/prospino
prospino_scratch/
.ghcr_token
.api_keys.env
.api_keys.*
.codex
*.sif
_evaluation_deprecated/
.gitignore
.mcp.json
.dockerignore
.github
# Research scratchpad — plot scripts, NeurIPS figures, runs.json snapshot,
# and a batch eval driver. The public single-run driver is
# scripts/launch_eval.sh.
utils/
