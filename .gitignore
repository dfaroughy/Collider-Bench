# ── OS / editor noise ────────────────────────────────────────────────────────
._*
.DS_Store
__MACOSX/
.vscode/
.idea/
*.swp

# ── Python build / cache ─────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
*.egg

# ── Virtual environments (created by the CLAUDE.md setup; never source) ──────
.venv/
venv/
env/
ENV/

# ── Run outputs (frozen artifacts; not source of truth) ─────────────────────
runs/

# ── Secrets — never commit ───────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
.api_keys.*

# detect-secrets baseline — generated locally; regenerate with
#   detect-secrets scan > .secrets.baseline
# Not tracked because it can hold per-clone file paths.
.secrets.baseline

# ── Image build artifacts ────────────────────────────────────────────────────
# Multi-GB binary blobs from `conda pack` and local image builds.
*.tar.gz
*.sif

# ── Vendored HEP simulator sources ───────────────────────────────────────────
# Not redistributed via git — baked into the public container image at
# /opt/sim/ during `docker build`. Users who pull the image never need
# these directories.
ColliderBench/tools/sim/MG5_aMC_v3_7_0/
ColliderBench/tools/sim/pythia8313/
ColliderBench/tools/sim/delphes/
ColliderBench/tools/sim/prospino/
