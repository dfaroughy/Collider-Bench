# Mirror of .gitignore for the public benchmark image build context.
# Anything listed here gets stripped from the COPY ... /app/... layers
# in docker/Dockerfile.bench and docker/Dockerfile.runtime, so the
# resulting public image cannot accidentally bake in vendor-specific
# files that the developer happened to have locally.

# Vendor / private overlay
agent_runtime/_runners_vendor.py
agent_runtime/__pycache__/
configs/claude_*.yaml
configs/codex_*.yaml
configs/gemini_*.yaml
configs/aider_*.yaml
docker/Dockerfile.dev

# Run outputs and ephemeral state
runs/
recast_*/
simulate_*/
validate_*/
__pycache__/
.pytest_cache/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
._*
